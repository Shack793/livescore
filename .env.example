# ───────────────  LiveScoreNow configuration  ───────────────
# Copy to .env and edit. Restart after changes:  sudo systemctl restart livescorenow

NODE_ENV=production
HOST=127.0.0.1                 # nginx talks to this; never expose it directly
PORT=3000
SITE_NAME=LiveScoreNow
SITE_URL=https://www.yourdomain.com      # used for canonical links + sitemap
SITE_TZ=Africa/Accra                      # default time zone before a visitor's own is detected
CONTACT_EMAIL=hello@yourdomain.com

# Admin panel at /admin (HTTP Basic auth). The admin is DISABLED until ADMIN_PASS is set. Use a long random password.
ADMIN_USER=admin
ADMIN_PASS=

DB_PATH=./data/livescorenow.db

# ── Where scores / fixtures / odds come from ─────────────────────
#   mock         simulated demo data for all 9 sports (no key needed) — for testing and previews ONLY
#   apifootball  real football data + bookmaker odds from API-Football (https://www.api-football.com)
#   apibasketball real basketball data + winner odds from API-Basketball
DATA_PROVIDER=mock
API_FOOTBALL_KEY=
# If you use the RapidAPI edition instead of api-sports.io, change the base URL / header per the provider docs.
API_FOOTBALL_BASE=https://v3.football.api-sports.io

# ── Second feed: basketball via API-Sports ──
# Set DATA_PROVIDER=multi (above) to turn this on. Football = FOOTBALL_PROVIDER
# Football uses API-Football. Basketball = BASKETBALL_PROVIDER (set
# apibasketball to enable). One shared key works for every API-Sports product
# you subscribed to (dashboard.api-sports.io → Profile → API Key).
# There is no Sportmonks fallback. If the API-Football daily quota is exhausted,
# the sync loop keeps retrying until the quota resets.
# The same account key works for every API-Sports sport you subscribed to.
FOOTBALL_PROVIDER=apifootball
BASKETBALL_PROVIDER=
API_SPORTS_KEY=
BASKETBALL_BASE=https://v1.basketball.api-sports.io
# Comma-separated basketball league IDs to follow (empty = all active leagues; 12 = NBA).
BASKETBALL_LEAGUES=
# Refetch throttles (seconds). The Free plan is 100 calls/day per sport — raise
# these a lot if you stay on Free. Paid plans can use the defaults below.
BASKETBALL_MIN_GAP_MS=1000
BASKETBALL_FIXTURES_SEC=900
BASKETBALL_LIVE_SEC=60
# Odds are fetched per game (?game=) and cached; only the winner market is used.
# Keep this off on the Free plan.
BASKETBALL_ODDS=true
BASKETBALL_ODDS_SEC=600
BASKETBALL_ODDS_MAX=12
MOCK_REALTIME=false            # mock only: true = follow the real clock instead of the looping demo clock

# ── Visitor country detection (decides which bookmakers are shown) ──
# Behind nginx (setup.sh does this) keep TRUST_PROXY=true so the real visitor IP is read from X-Forwarded-For.
# If you put Cloudflare in front, its CF-IPCountry header is used automatically (also needs TRUST_PROXY=true).
TRUST_PROXY=true
DEFAULT_COUNTRY=               # used when the country cannot be detected, e.g. GH. Empty = unknown → only "worldwide" bookmakers
ALLOW_CC_QUERY=false           # true lets ?cc=GH preview any country on the live site (handy while testing)

# ── Sync tuning (seconds) — defaults are fine; raise them to save API quota ──
SYNC_ENABLED=true
LIVE_INTERVAL_SEC=20
LIVE_ODDS_INTERVAL_SEC=30
ODDS_INTERVAL_SEC=300
FIXTURES_INTERVAL_SEC=600
STANDINGS_INTERVAL_SEC=21600
REFERENCE_INTERVAL_SEC=86400
WINDOW_PAST_DAYS=3
WINDOW_FUTURE_DAYS=7
# SPORTS=football              # restrict which sports are synced (default: everything the provider supports)

SSE_MAX_PER_IP=8               # simultaneous live-update connections per visitor IP
API_RATE_PER_MIN=240           # public JSON API requests per IP per minute

# --- Pitchside Forum linking (leave FORUM_URL empty to hide all forum links) ---
FORUM_URL=https://www.pitchsideforum.com
FORUM_NAME=Pitchside Forum
# Optional deep-link template for "Discuss this match". Placeholders: {query} {home} {away} {league}
FORUM_MATCH_URL=
# Extra sites (space separated origins) allowed to iframe /embed/* widgets. The forum origin is added automatically.
EMBED_ORIGINS=
